# Python: the engine's own environment and bytecode. The virtual environment is created by
# start.bat and is never committed; requirements.txt is what describes it.
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node: the window's dependencies, and the built interface. Both are produced by start.bat.
# `frontend/dist` is what the engine serves to the window, and it is a build artefact, not source.
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# Packaging output, from `npm run pack` / `npm run dist`.
/dist/
/release/

# Local data: anything a person trimmed while trying the application, and its logs.
*.trimmerproj
*.trimmerproj-journal
/scratch/
*.log

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
