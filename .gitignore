# Rust
/target
**/*.rs.bk
*.pdb

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Playwright: traces, screenshots on failure and the HTML report are all build output. `screens/` is
# deliberately NOT ignored — it holds the interface screenshots a layout test writes, which are the
# thing a person reviews when the design changes.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Tauri build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Local data: projects, caches, logs, licences
.local/
*.trimmerproj
*.trimmerproj-journal
/scratch/
*.log

# Media used by tests and oracle runs
/testdata/generated/
/crates/trimmer-core/tests/fixtures/generated/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Python oracle virtualenv (the V1 engine is invoked in-place, never vendored)
__pycache__/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
