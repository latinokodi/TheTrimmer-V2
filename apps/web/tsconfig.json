{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  /*
   * `tests` as well as `src`, so `npm run typecheck` covers the browser tests too. A test that only
   * fails when it runs is a test that costs a minute to find out about; one that fails the type check
   * costs a second. `playwright.config.ts` is included for the same reason.
   */
  "include": ["src", "tests", "playwright.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
